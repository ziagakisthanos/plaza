<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>platform.zone01</groupId>
    <artifactId>buy-01</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <!-- THIS is what makes it a parent coordinator, not an app -->
    <packaging>pom</packaging>

    <!-- The list of child modules.  -->
    <modules>
        <module>discovery</module>
        <module>gateway</module>
        <module>user-service</module>
        <module>common-security</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- Spring Cloud version line -->
        <spring-cloud.version>2023.0.3</spring-cloud.version>
    </properties>

    <!-- "here are versions IF a child asks", not forced on anyone -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>